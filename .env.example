# All variables are optional - app/config.py has working defaults.

DATABASE_URL=sqlite:///./exchange_rates.db

# Admin endpoints (POST /api/admin/*) - empty disables them (503)
ADMIN_API_KEY=
LOG_LEVEL=INFO

# ---- Scheduling -----------------------------------------------------
# Crawls run in-process. Set false to drive them externally over
# POST /api/admin/crawl instead.
SCHEDULER_ENABLED=true
# Which sources this process collects: all | fast | slow.
# Split deployments run the web service with fast and a separate
# `python -m scripts.worker` with slow, keeping headless Chromium out
# of the process that serves requests. Requires Postgres, not SQLite.
CRAWL_GROUP=all
CRAWL_TIMEZONE=Asia/Ulaanbaatar
CRAWL_ACTIVE_START_HOUR=8
CRAWL_ACTIVE_END_HOUR=20
CRAWL_ACTIVE_INTERVAL_MINUTES=30
CRAWL_OFFPEAK_INTERVAL_MINUTES=60
# Random spread on every trigger, so no bank sees an exact interval.
CRAWL_JITTER_SECONDS=90
# Playwright sources run this many times less often (4 => hourly while
# active). Raise it if the instance is memory constrained.
CRAWL_PLAYWRIGHT_MULTIPLIER=4
# How far back a source may look for its most recent publication.
SOURCE_LOOKBACK_DAYS=7

# ---- Freshness thresholds behind the v1 `status` field ---------------
STALE_AFTER_INTERVALS=3
FAILING_AFTER_ATTEMPTS=3
PUBLISHED_STALE_HOURS=36
# 0 keeps every snapshot; they are only written when rates change.
SNAPSHOT_RETENTION_DAYS=0

# ---- HTTP / crawling ------------------------------------------------
SSL_VERIFY=true
REQUEST_TIMEOUT=30
PLAYWRIGHT_TIMEOUT=60000
ENABLE_PARALLEL=true
# Seconds one scheduled run waits for its sources before reporting the
# rest overdue (they keep running and still save).
CRAWL_BATCH_DEADLINE_SECONDS=600
MAX_WORKERS=8
PLAYWRIGHT_MAX_WORKERS=3

# Keeps a sleeping free-tier instance awake - empty disables it.
SELF_PING_URL=

# ---- Public API safeguards ------------------------------------------
API_MAX_LIMIT=100
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000

# ---- International sources ------------------------------------------
# Fetched this many times a day (must divide 24); hard per-source cap.
INTL_CRAWLS_PER_DAY=4
INTL_DAILY_CALL_LIMIT=4
# fxRatesAPI key (secret). Empty disables that source.
FXRATESAPI_KEY=
# Keys the iOS app sends as X-App-Key. EMPTY = DEVELOPMENT MODE: the
# licence-restricted fxRatesAPI rates go to any caller. Fine locally;
# never on a public server. Production sets REQUIRE_APP_KEY=true, which
# refuses to start while APP_API_KEYS is empty.
APP_API_KEYS=
REQUIRE_APP_KEY=false
# Absolute origin for logo_url (e.g. https://api.example.com).
PUBLIC_BASE_URL=

# ArigBank only - optional, the crawler signs in fresh when unset.
ARIGBANK_BEARER_TOKEN=

# Every bank endpoint URL (KHANBANK_URI, GOLOMT_URI, ...) already has a
# working default in app/config.py. Only set one here if a bank changes
# its URL and you need to override it without a code change.
